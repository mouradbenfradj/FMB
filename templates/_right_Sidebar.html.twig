<!-- Right Sidebar -->
<div class="right-bar">
	<div
		data-simplebar class="h-100">
		<!-- Nav tabs -->
		<ul class="nav nav-tabs nav-bordered nav-justified" role="tablist">
			<li class="nav-item">
				<a class="nav-link py-2" data-toggle="tab" href="#chat-tab" role="tab">
					<i class="mdi mdi-message-text d-block font-22 my-1"></i>
				</a>
			</li>
			<li class="nav-item">
				<a class="nav-link py-2" data-toggle="tab" href="#tasks-tab" role="tab">
					<i class="mdi mdi-format-list-checkbox d-block font-22 my-1"></i>
				</a>
			</li>
			<li class="nav-item">
				<a class="nav-link py-2 active" data-toggle="tab" href="#settings-tab" role="tab">
					<i class="mdi mdi-cog-outline d-block font-22 my-1"></i>
				</a>
			</li>
			{% if app.request.attributes.get('_route') == 'app_m_a_e_corde' %}
				<li class="nav-item">
					<a class="nav-link py-2" data-toggle="tab" href="#formulaire-tab" role="tab">
						<i class="mdi mdi-cog-outline d-block font-22 my-1"></i>
					</a>
				</li>
			{% endif %}
		</ul>
		<!-- Tab panes -->
		<div class="tab-content pt-0">
			<div class="tab-pane" id="chat-tab" role="tabpanel">{% include "rightSidebar/chat_tab.html.twig" %}</div>

			<div class="tab-pane" id="tasks-tab" role="tabpanel">
				{% include "rightSidebar/tasks_tab.html.twig" %}
			</div>
			<div class="tab-pane " id="settings-tab" role="tabpanel">
				{% include "rightSidebar/settings_tab.html.twig" %}</div>
			<div class="tab-pane active" id="formulaire-tab" role="tabpanel">
				{% include "rightSidebar/formulaire_tab.html.twig" %}</div>
		</div>
	</div>
	<!-- end slimscroll-menu-->
</div>
<!-- /Right-bar -->
