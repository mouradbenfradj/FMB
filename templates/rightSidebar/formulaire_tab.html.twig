{% if app.request.attributes.get('_route') == 'app_m_a_e_corde' %}
	{{ component('MAECorde', { parc: parc }) }}
	<script>
		function initDisponibiliterManager()
{

const disponibiliterInput = document.getElementById( 'mae_corde_disponibiliter' );
if ( ! disponibiliterInput )
{



console.log( '⏳ Champ non trouvé, réessai dans 100ms...' );
setTimeout( initDisponibiliterManager, 100 );
return;



}

const checkboxes = document.querySelectorAll( 'input[name="emplacement[]"]' );
let currentValue = parseInt( disponibiliterInput.value ) || 100; // 100 par défaut
function updateDisponibiliter( value )
{



currentValue = Math.max( 0, value ); // Empêcher les valeurs négatives
disponibiliterInput.value = currentValue;



}
function updateCheckboxesState()
{



checkboxes.forEach( checkbox => {



checkbox.disabled = !checkbox.checked && currentValue === 0;



} );



}
checkboxes.forEach( checkbox => {



checkbox.addEventListener( 'change', function ()
{



if ( this.checked )
{ // Cocher : décrémenter
if ( currentValue > 0 )
{



updateDisponibiliter( currentValue - 1 );



}
else
{



this.checked = false;
alert( '❌ Plus de disponibilité disponible' );
return;



} }
else
{ // Décocher : incrémenter
updateDisponibiliter( currentValue + 1 );



} updateCheckboxesState();



} );



} );
updateCheckboxesState();
console.log( '✅ Gestionnaire de disponibilité initialisé' );



}
// Démarrer l'initialisation
document.addEventListener( 'DOMContentLoaded', initDisponibiliterManager );
	</script>
{% endif %}
