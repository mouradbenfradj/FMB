{% extends 'base.html.twig' %}

{% block title %}Retrait Transfert
{% endblock %}

{% block stylesheets %}
	{{ encore_entry_link_tags('etat_actuel_prod') }}
{% endblock %}
{% block javascripts %}
	{{ encore_entry_script_tags('etat_actuel_prod') }}
	<script>
		var filieresData = {{ filieresJson|raw }};
	</script>
{% endblock %}
{% block body %}
	<div class="row">
		<div class="col-sm-12">
			<div class="card-box">
				<h4>Retrait Transfert</h4>
				<p>Sélectionnez les emplacements sources (remplis) et destinations (vides) pour le transfert.</p>
				<form method="post">
					<div class="mb-2">
						<div class="row">
							<div class="col-12 text-sm-center form-inline">
								<div class="form-group mr-2">
									<select id="sort-column-select" class="custom-select custom-select-sm">
										<option value="0">Tri par Réf. Filière</option>
										<option value="1">Tri par Remplissage Filière (%)</option>
										<option value="2">Tri par Flottabilité Filière (%)</option>
										<option value="3">Tri par Taille Filière (m)</option>
										<option value="4">Tri par Total Emplacements</option>
									</select>
								</div>
								<div class="form-group mr-2">
									<select id="sort-direction-select" class="custom-select custom-select-sm">
										<option value="ASC">Croissant</option>
										<option value="DESC">Décroissant</option>
									</select>
								</div>
							</div>
						</div>
					</div>

					<div class="mb-2">
						<div class="row">
							<div class="col-12 text-sm-center form-inline">
								<button type="button" class="btn btn-sm btn-outline-secondary page-size-btn" data-page-size="10">10</button>
								<button type="button" class="btn btn-sm btn-outline-secondary page-size-btn active" data-page-size="20">20</button>
								<button type="button" class="btn btn-sm btn-outline-secondary page-size-btn" data-page-size="50">50</button>
								<button type="button" class="btn btn-sm btn-outline-secondary page-size-btn" data-page-size="100">100</button>
								<button type="button" class="btn btn-sm btn-outline-secondary page-size-btn" data-page-size="200">200</button>
							</div>
						</div>
					</div>

					<div class="progress mb-3" id="table-loading-progress">
						<div class="progress-bar progress-bar-striped progress-bar-animated bg-primary" role="progressbar" style="width: 100%" aria-valuenow="100" aria-valuemin="0" aria-valuemax="100">Chargement du tableau...</div>
					</div>

					<table id="demo-foo-row-toggler" class="table table-bordered toggle-circle mb-0 demo-foo-row-toggler" data-page-size="20" style="display: none;">
						<thead>
							<tr>
								<th data-toggle="true">Réf. Filière</th>
								<th>Remplissage Filière (%)</th>
								<th>Flottabilité Filière (%)</th>
								<th data-hide="all">Taille Filière (m)</th>
								<th data-hide="all">Total Emplacements (u)</th>
								<th data-hide="all">Emplacements Vides (u)</th>
								<th data-hide="all">Emplacements Remplis (u)</th>
								<th data-hide="all">Total Cordes (u)</th>
								<th data-hide="all">Total Cordes Huitre (u)</th>
								<th data-hide="all">Total Cordes Moule (u)</th>
								<th data-hide="all">Total Lanternes (u)</th>
								<th data-hide="all">Total Poches (u)</th>
								<th data-hide="all">Dérniere Date De MAE</th>
								<th data-hide="all">Total Passages chaussettes (u)</th>
								<th data-hide="all">Segments</th>
							</tr>
						</thead>
						<tbody id="table-body"></tbody>
					</table>

					<div class="mt-3">
						<button type="submit" class="btn btn-primary">Valider la sélection</button>
					</div>
				</form>
			</div>
			<!-- end card-box -->
		</div>
		<!-- end col -->
	</div>
	<!-- end row -->

{% endblock %}
