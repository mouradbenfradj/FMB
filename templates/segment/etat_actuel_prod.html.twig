{% for segment in filiere.segments %}
	{% set etat = etat_actuel_prod_segment(segment) %}
	<div data-controller="reveal" data-reveal-hidden-class="d-none">
		<button data-action="reveal#toggle" type="button" class="btn">
			Segment
			{{ segment.nomSegment }}</button>

		<table data-reveal-target="item" class="d-none mt-4 demo-foo-row-toggler table table-bordered toggle-circle mb-0" width="100%">
			<tbody>
				<tr>
					<th>
						Nom Segment
						<span class="footable-sort-indicator"></span>
					</th>
					<td>
						Segment
						{{ segment.nomSegment }}
					</td>
				</tr>
				<tr>
					<th>
						Remplissage Segment (%)
						<span class="footable-sort-indicator"></span>
					</th>
					<td>
						{% set rouge = etat.totalEmplacement > 0 ? ((etat.totalCorde / etat.totalEmplacement) * 100)|round : 0 %}

						<div class="progress mb-0">
							<div class="progress-bar bg-danger" role="danger" style="width: {{rouge}}%" aria-valuenow="{{rouge}}" aria-valuemin="0" aria-valuemax="100">
								{{rouge}}
								% R
							</div>
							<div class="progress-bar progress-bar-striped bg-success" role="progressbar" style="width: {{ 100 - rouge}}%" aria-valuenow=" {{ 100 - rouge}}%" aria-valuemin="0" aria-valuemax="100">
								{{ 100 - rouge}}
								% V
							</div>
						</div>

						<div class="row">
							<div class="col-lg-4">
								<div class="grid-container">
									Places totales
									{{etat.totalEmplacement}}

								</div>
							</div>
							<div class="col-lg-4">
								<div class="grid-container">
									Places Remplies
									{{etat.totalCorde}}

								</div>
							</div>
							<div class="col-lg-4">
								<div class="grid-container">
									Places Vides
									{{etat.totalEmplacement - etat.totalCorde}}

								</div>
							</div>

						</div>


					</td>
				</tr>
				<tr>
					<th>Flottabilité Segment (%)<span class="footable-sort-indicator"></span>
					</th>
					<td>
						{% set vert = etat.flottabiliter > 0 ? ((etat.flottabiliter - etat.poidCordes)/etat.flottabiliter *100) : 0 %}
						{% if vert < 0 %}
							{% set classRouge = "bg-warning" %}
							{% set classVert = " bg-info" %}
						{% else %}
							{% set classRouge = "bg-danger" %}
							{% set classVert = " bg-success" %}
						{% endif %}
						<div class="progress mb-0">
							<div class="progress-bar  progress-bar-striped {{classRouge}}" role="danger" style="width: {{ (100 - vert)|round }}%" aria-valuenow="{{ (100 - vert)|round }}" aria-valuemin="0" aria-valuemax="100">
								{{ (100 - vert)|round }}
								% R</div>
							<div class="progress-bar progress-bar-striped {{classVert}}" role="progressbar" style="width: {{  vert|round }}%" aria-valuenow="{{ vert|round }}" aria-valuemin="0" aria-valuemax="100">
								{{ vert|round }}
								% V</div>
						</div>


						<div class="row">
							<div class="col-lg-3">
								<div class="grid-container">
									F
									{{etat.volumesTotale}}
									(L)
								</div>
							</div>
							<div class="col-lg-3">
								<div class="grid-container">
									F
									{{etat.flottabiliter}}
									(kgf)
								</div>
							</div>
							<div class="col-lg-6">
								<div class="grid-container">
									Production
									{{etat.poidCordes}}
									(kgf)
								</div>
							</div>
						</div>
					</td>
				</tr>

				<tr>
					<th>
						Taille Segment (m)
						<span class="footable-sort-indicator"></span>
					</th>
					<td>{{ etat.taille }}</td>
				</tr>
				<tr>
					<th>
						Total Emplacements (u)
						<span class="footable-sort-indicator"></span>
					</th>
					<td>{{etat.totalEmplacement }}</td>
				</tr>
				<tr>
					<th>
						Emplacements Vides (u)
						<span class="footable-sort-indicator"></span>
					</th>
					<td>{{etat.emplacementVide}}</td>
				</tr>
				<tr>
					<th>
						Emplacements Remplis (u)
						<span class="footable-sort-indicator"></span>
					</th>
					<td>{{etat.emplacementRemplit}}</td>
				</tr>
				<tr>
					<th>
						Total Cordes (u)
						<span class="footable-sort-indicator"></span>
					</th>
					<td>{{etat.totalCorde }}</td>
				</tr>
				<tr>
					<th>
						Total Cordes Huitre (u)
						<span class="footable-sort-indicator"></span>
					</th>
					<td>{{etat.totalCordeHuitre}}</td>
				</tr>
				<tr>
					<th>
						Total Cordes Moule (u)
						<span class="footable-sort-indicator"></span>
					</th>
					<td>{{etat.totalCordeMoule}}</td>
				</tr>
				<tr>
					<th>
						Total Lanternes (u)
						<span class="footable-sort-indicator"></span>
					</th>
					<td>{{etat.totalCordeLanterne}}</td>
				</tr>
				<tr>
					<th>
						Total Poches (u)
						<span class="footable-sort-indicator"></span>
					</th>
					<td>{{etat.totalCordePoche}}</td>
				</tr>
				<tr>
					<th>
						Total Passages chaussettes (u)
						<span class="footable-sort-indicator"></span>
					</th>
					<td>{{etat.passageChaussette}}</td>
				</tr>
				<tr>
					<th>
						Dérniere Date De MAE
						<span class="footable-sort-indicator"></span>
					</th>
					<td>{{ etat.dateDeMAE ? etat.dateDeMAE|date('Y-m-d') : 'N/A' }}</td>
				</tr>

			</tbody>
		</table>
		{{ include('emplacement/etat_actuel_prod.html.twig', {segment: segment}) }}
	</div>
{% endfor %}
