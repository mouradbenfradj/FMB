{% extends 'base.html.twig' %}

{% block title %}Confirmation de Préparation
{% endblock %}

{% block body %}
	<div class="container-fluid">
		<div class="row">
			<div class="col-12">
				<div class="card">
					<div class="card-body">
						<h4 class="header-title">Préparation Réussie</h4>
						<p>La préparation de
							{{ type }}
							a été effectuée avec succès.</p>
						<a href="{{ path('app_home') }}" class="btn btn-primary">Retour à l'accueil</a>
						<a href="{{ path('app_preparation', {'type': type, 'parc': parc.id}) }}" class="btn btn-secondary">Préparer un autre
							{{ type }}</a>
					</div>
				</div>
			</div>
		</div>
	</div>
{% endblock %}
