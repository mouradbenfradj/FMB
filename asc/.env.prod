### Production environment variables

###> symfony/framework-bundle ###
APP_ENV=prod
APP_DEBUG=0
# APP_SECRET must be provided via the environment (GitHub Actions secret or server env)
APP_SECRET=${{ secrets.APP_SECRET }}
APP_URL=https://aquafishtritarconsult.com
###< symfony/framework-bundle ###

###> doctrine/doctrine-bundle ###
# Use environment variables that will be set from GitHub Actions secrets at deploy time
DB_HOST=${{ secrets.DB_HOST }}
DB_PORT=3306
DB_NAME=${{ secrets.DB_NAME }}
DB_USERNAME=${{ secrets.DB_USERNAME }}
DB_PASSWORD=${{ secrets.DB_PASSWORD }}

# Composable DATABASE_URL using the env vars above (used by Doctrine)
DATABASE_URL="mysql://${{ secrets.DB_USERNAME }}:${{ secrets.DB_PASSWORD }}@${{ secrets.DB_HOST }}:3306/${{ secrets.DB_NAME }}?serverVersion=mariadb-10.6.12&charset=utf8mb4"
###< doctrine/doctrine-bundle ###

###> symfony/mailer ###
# Configure the mailer DSN in the deployment environment if needed
MAILER_DSN=%env(MAILER_DSN)%
###< symfony/mailer ###

###> Cache / Redis ###
REDIS_URL=redis://localhost:6379
CACHE_ADAPTER=cache.adapter.redis
REDIS_CLIENT=predis
CACHE_PREFIX=asc_prod_
CACHE_LIFETIME=3600
###< Cache / Redis ###

###> FTP Configuration ###
# Use env variables for FTP credentials in CI/deploy
FTP_SERVER=${{ secrets.FTP_SERVER }}
FTP_USERNAME=${{ secrets.FTP_USERNAME }}
FTP_PASSWORD=${{ secrets.FTP_PASSWORD }}
###< FTP Configuration ###

###> CORS / Proxies / Hosts ###
CORS_ALLOW_ORIGIN='^https?://(localhost|127\.0\.0\.1|aquafishtritarconsult\.com)(:[0-9]+)?$'
TRUSTED_PROXIES=127.0.0.1,REVERSE_PROXY_IP
TRUSTED_HOSTS='^aquafishtritarconsult\.com$'
###< CORS / Proxies / Hosts ###

###> Application Specific Settings ###
# File uploads
UPLOAD_DIR=%kernel.project_dir%/public/uploads
MAX_UPLOAD_SIZE=10M

# Security / session
SECURE_SCHEME=https
SESSION_LIFETIME=3600
COOKIE_SECURE=true
COOKIE_HTTPONLY=true
###< Application Specific Settings ###
