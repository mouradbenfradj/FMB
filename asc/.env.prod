# Production environment variables

###> symfony/framework-bundle ###
APP_ENV=prod
# Production environment variables
# Ces variables sont complétées par les GitHub Secrets en production

###> symfony/framework-bundle ###
APP_ENV=prod
APP_DEBUG=0
APP_SECRET=%env(APP_SECRET)%
APP_URL=https://aquafishtritarconsult.com

###> doctrine/doctrine-bundle ###
# Les identifiants de base de données sont récupérés depuis GitHub Secrets
DB_HOST=%env(DB_HOST)%
DB_NAME=%env(DB_NAME)%
DB_USERNAME=%env(DB_USERNAME)%
DB_PASSWORD=%env(DB_PASSWORD)%
DATABASE_URL=mysql://${DB_USERNAME}:${DB_PASSWORD}@${DB_HOST}:3306/${DB_NAME}?serverVersion=mariadb-10.6.12&charset=utf8mb4

###> symfony/mailer ###
# Configuration du mailer à définir dans .env.local.prod
MAILER_DSN=null

###> Cache Configuration ###
# Configuration du cache avec système de fichiers
CACHE_ADAPTER=cache.adapter.filesystem
CACHE_DIRECTORY=%kernel.cache_dir%/cache
CACHE_PREFIX=asc_prod_
CACHE_LIFETIME=3600

###> FTP Configuration ###
# Informations FTP depuis GitHub Secrets
FTP_SERVER=%env(FTP_SERVER)%
FTP_USERNAME=%env(FTP_USERNAME)%
FTP_PASSWORD=%env(FTP_PASSWORD)%

###> nelmio/cors-bundle ###
CORS_ALLOW_ORIGIN='^https://aquafishtritarconsult\.com$'

###> Trusted Proxies ###
TRUSTED_PROXIES=127.0.0.1,REVERSE_PROXY_IP

###> Trusted Hosts ###
TRUSTED_HOSTS='^aquafishtritarconsult\.com$'

###> Application Specific Settings ###
# Configuration des uploads
UPLOAD_DIR=%kernel.project_dir%/public/uploads
MAX_UPLOAD_SIZE=10M

# Configuration de sécurité
SECURE_SCHEME=https
SESSION_LIFETIME=3600
COOKIE_SECURE=true
COOKIE_HTTPONLY=true
APP_DEBUG=0

# URL du site en production
APP_URL=https://aquafishtritarconsult.com

###> doctrine/doctrine-bundle ###
# Format: DATABASE_URL="mysql://USER:PASSWORD@HOST:PORT/DBNAME?serverVersion=VERSION"
DATABASE_URL="mysql://%env(DB_USERNAME)%:%env(DB_PASSWORD)%@%env(DB_HOST)%:3306/%env(DB_NAME)%?serverVersion=mariadb-10.6.12&charset=utf8mb4"

###> symfony/mailer ###
MAILER_DSN=smtp://YOUR_SMTP_SERVER:PORT

###> Cache Configuration ###
REDIS_URL=redis://localhost:6379
CACHE_ADAPTER=cache.adapter.redis
REDIS_CLIENT=predis
CACHE_PREFIX=asc_prod_

###> nelmio/cors-bundle ###
CORS_ALLOW_ORIGIN='^https?://(localhost|127\.0\.0\.1|aquafishtritarconsult\.com)(:[0-9]+)?$'

###> Trusted Proxies ###
TRUSTED_PROXIES=127.0.0.1,REVERSE_PROXY_IP

###> Trusted Hosts ###
TRUSTED_HOSTS='^aquafishtritarconsult\.com$'

###> Application Specific Settings ###
# Temps d'expiration du cache (en secondes)
CACHE_LIFETIME=3600

# Configuration des uploads
UPLOAD_DIR=%kernel.project_dir%/public/uploads
MAX_UPLOAD_SIZE=10M

# Configuration de sécurité
SECURE_SCHEME=https
SESSION_LIFETIME=3600