### This file carries development defaults (copied from .env.dev).
### DO NOT COMMIT PRODUCTION SECRETS HERE. Use .env.local or CI secrets instead.

###> symfony/framework-bundle ###
APP_ENV=prod
APP_SECRET=${{ secrets.APP_SECRET }}
###< symfony/framework-bundle ###

###> doctrine/doctrine-bundle ###
# Database URL configured through environment variables
DATABASE_URL="mysql://${{ secrets.DB_USERNAME }}:${{ secrets.DB_PASSWORD }}@${{ secrets.DB_HOST }}/${{ secrets.DB_NAME }}"
###< doctrine/doctrine-bundle ###

###> symfony/messenger ###
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0
###< symfony/messenger ###

###> symfony/mailer ###
MAILER_DSN=null://null
###< symfony/mailer ###

###> nelmio/cors-bundle ###
CORS_ALLOW_ORIGIN='^https?://(localhost|127\.0\.0\.1)(:[0-9]+)?$'
###< nelmio/cors-bundle ###

# URLs par environnement
APP_URL_LOCAL=http://localhost:8000
APP_URL_PROD=https://www.oysterpro.com

# Redis configuration (dev)
REDIS_URL=redis://localhost:6379

# FTP Configuration
FTP_SERVER=${{ secrets.FTP_SERVER }}
FTP_USERNAME=${{ secrets.FTP_USERNAME }}
FTP_PASSWORD=${{ secrets.FTP_PASSWORD }}
