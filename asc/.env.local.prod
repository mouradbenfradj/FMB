# Production environment sensitive variables - NE PAS VERSIONNER CE FICHIER !
# Ce fichier sert de modèle pour la configuration de production
# Les valeurs sensibles sont gérées via GitHub Secrets

###> symfony/framework-bundle ###
# Le secret de l'application est géré via GitHub Secrets
APP_SECRET=%env(APP_SECRET)%

###> doctrine/doctrine-bundle ###
# Configuration de la base de données via GitHub Secrets
DB_HOST=%env(DB_HOST)%
DB_NAME=%env(DB_NAME)%
DB_USERNAME=%env(DB_USERNAME)%
DB_PASSWORD=%env(DB_PASSWORD)%

###> FTP Configuration ###
# Configuration FTP via GitHub Secrets
FTP_SERVER=%env(FTP_SERVER)%
FTP_USERNAME=%env(FTP_USERNAME)%
FTP_PASSWORD=%env(FTP_PASSWORD)%

###> symfony/mailer ###
# À configurer avec vos paramètres SMTP
MAILER_DSN=smtp://%env(MAILER_USER)%:%env(MAILER_PASSWORD)%@%env(MAILER_HOST)%:%env(MAILER_PORT)%

###> Cache Configuration ###
# Configuration des chemins de cache
CACHE_DIR=/var/www/aquafishtritarconsult.com/var/cache
APP_CACHE_DIR=/var/www/aquafishtritarconsult.com/var/cache/prod

###> Application Specific Settings ###
# Chemins de production spécifiques
PUBLIC_DIR=/var/www/aquafishtritarconsult.com/public
LOG_DIR=/var/www/aquafishtritarconsult.com/var/log

# Configuration de sécurité supplémentaire
TRUSTED_PROXIES=127.0.0.1,REVERSE_PROXY_IP
SSL_CERT_PATH=/etc/letsencrypt/live/aquafishtritarconsult.com/fullchain.pem
SSL_KEY_PATH=/etc/letsencrypt/live/aquafishtritarconsult.com/privkey.pem

###> Cache Configuration ###
# Configuration Redis avec Predis
REDIS_URL=redis://localhost:6379
REDIS_CLIENT=predis
CACHE_ADAPTER=cache.adapter.redis
CACHE_PREFIX=asc_prod_
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# Décommenter et configurer si vous utilisez l'authentification Redis
# REDIS_PASSWORD=your_redis_password

###> Application Specific Secrets ###
JWT_SECRET=ChangeThisToASecureJWTSecret
ADMIN_PASSWORD=ChangeThisToASecureAdminPassword