<!DOCTYPE html>
<html lang="{{ app.request.locale }}">
	<head>
		<meta charset="UTF-8">
		<title>
			{% block title %}
				Logiciel ASC by TAC & SIDRATSOFT
			{% endblock %}
		</title>
		<meta name="viewport" content="width=device-width, initial-scale=1.0">
		<meta content="Logiciel ASC by TAC & SIDRATSOFT" name="description"/>
		<meta content="Mourad Ben Fradj" name="author"/>
		<meta http-equiv="X-UA-Compatible" content="IE=edge"/>
		<link rel="shortcut icon" href="{{ asset('build/images/favicon.ico') }}">
		{% block stylesheets %}
			{{ encore_entry_link_tags('app') }}
		{% endblock %}
		{% block javascripts %}
			{{ encore_entry_script_tags('app') }}
		{% endblock %}
	</head>
	<body {{ stimulus_controller('symfony/ux-swup/swup', { containers: ['#swup', '#nav', '#parc', '#parc2'], animateHistoryBrowsing: true, animationSelector: '[class*="transition-"]', cache: true, linkSelector: 'a[href]', theme: 'slide', debug: true, } ) }} data-layout-mode="horizontal" data-layout='{"mode": "light", "width": "fluid", "menuPosition": "fixed", "topbar": {"color": "dark"}, "showRightSidebarOnPageLoad": true}'>
		<div id="wrapper">
			{% include '_header.html.twig' with { 'parcs': parcs ?? [],'parc': app.request.session.get('parc').id ?? 0  } only %}
			{% include '_nav.html.twig'  with {'parc':  parc.id ?? 0  } only %}
			<div class="content-page">
				<div class="content">
					<div class="container-fluid" id="swup">
						{% include '_aside.html.twig'  with { 'parcs': parcs ?? [],'parc': app.request.session.get('parc').id ?? 0 } only %}
						{% block body %}{% endblock %}
					</div>
				</div>
				{% include '_footer.html.twig' %}
			</div>
		</div>
		{% include '_right_Sidebar.html.twig' %}
		<div class="rightbar-overlay"></div>

	</body>
</html>
