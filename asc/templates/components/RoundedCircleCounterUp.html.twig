<div class="col-md-6 col-xl-3">
    <div class="widget-rounded-circle card-box">
        <div class="row">
            <div class="col-6">
                <div class="avatar-lg rounded-circle bg-soft-{{niveau}} border-{{niveau}} border">
                    <i class="{{icon}} font-22 avatar-title text-{{niveau}}"></i>
                </div>
            </div>
            <div class="col-6">
                <div class="text-right">
                    <h3 class="mt-1"><span data-plugin="counterup">{{value}}</span></h3>
                    <p class="text-muted mb-1 text-truncate">{{titre}}</p>
                </div>
            </div>
        </div> <!-- end row-->
    </div> <!-- end widget-rounded-circle-->
</div> <!-- end col-->

