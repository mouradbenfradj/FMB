{% extends 'base.html.twig' %}

{% block title %}Validation MAE Corde
{% endblock %}

{% block body %}
	<div class="container mt-4">
		<div class="row">
			<div class="col-12">
				<h1 class="mb-4">Validation de la Mise à l'Eau</h1>

				{% for message in app.flashes('error') %}
					<div class="alert alert-danger">{{ message }}</div>
				{% endfor %}

				<!-- Carte de résumé -->
				<div class="card mb-4">
					<div class="card-header bg-primary text-white">
						<h5 class="mb-0">Résumé de l'opération</h5>
					</div>
					<div class="card-body">
						<div class="row">
							<div class="col-md-6">
								<h6>Informations générales</h6>
								<ul class="list-unstyled">
									<li>
										<strong>Parc :</strong>
										{{ parc.libParc ?? 'Non spécifié' }}</li>
									<li>
										<strong>Date de MAE :</strong>
										{{ dateDeMAE|date('d/m/Y') }}</li>
									<li>
										<strong>Corde :</strong>
										{{ corde.corde.nom }}</li>
									<li>
										<strong>Lot :</strong>
										{{ corde.stockArticleSn.numeroSerie }}</li>
									<li>
										<strong>Phase :</strong>
										{% if formData.phase == 1 %}
											Prégrossissement
										{% elseif formData.phase == 2 %}
											Grossissement
										{% elseif formData.phase == 3 %}
											Commercial
										{% endif %}
									</li>
								</ul>
							</div>
							<div class="col-md-6">
								<h6>Statistiques</h6>
								<ul class="list-unstyled">
									<li>
										<strong>Nombre de cordes :</strong>
										{{ cordesCount }}</li>
									<li>
										<strong>Nombre d'emplacements :</strong>
										{{ emplacementsCount }}</li>
									<li>
										<strong>Disponibilité :</strong>
										{{ formData.disponibiliter }}</li>
									<li>
										<strong>Densité :</strong>
										{{ formData.densiter }}
										U/Corde</li>
								</ul>
							</div>
						</div>
					</div>
				</div>

				<!-- Vérification de correspondance -->
				{% if cordesCount != emplacementsCount %}
					<div class="alert alert-warning">
						<strong>Attention :</strong>
						Le nombre de cordes ({{ cordesCount }}) ne correspond pas au nombre d'emplacements ({{ emplacementsCount }}).
					</div>
				{% else %}
					<div class="alert alert-success">
						<strong>Parfait :</strong>
						Le nombre de cordes correspond au nombre d'emplacements.
					</div>
				{% endif %}

				<!-- Détails des cordes -->
				<div class="card mb-4">
					<div class="card-header">
						<h5 class="mb-0">Cordes à assigner</h5>
					</div>
					<div class="card-body">
						{% if cordes|length > 0 %}
							<div class="table-responsive">
								<table class="table table-striped">
									<thead>
										<tr>
											<th>#</th>
											<th>ID Corde</th>
											<th>Type</th>
											<th>Lot Article</th>
											<th>Statut</th>
										</tr>
									</thead>
									<tbody>
										{% for corde in cordes %}
											<tr>
												<td>{{ loop.index }}</td>
												<td>{{ corde.id }}</td>
												<td>{{ corde.corde.nom ?? 'N/A' }}</td>
												<td>{{ corde.stockArticleSn }}</td>
												<td>
													<span class="badge bg-success">Prête</span>
												</td>
											</tr>
										{% endfor %}
									</tbody>
								</table>
							</div>
						{% else %}
							<p class="text-muted">Aucune corde trouvée.</p>
						{% endif %}
					</div>
				</div>

				<!-- Détails des emplacements -->
				<div class="card mb-4">
					<div class="card-header">
						<h5 class="mb-0">Emplacements sélectionnés</h5>
					</div>
					<div class="card-body">
						{% if emplacements|length > 0 %}
							<div class="table-responsive">
								<table class="table table-striped">
									<thead>
										<tr>
											<th>#</th>
											<th>ID Emplacement</th>
											<th>Nom</th>
											<th>Localisation</th>
										</tr>
									</thead>
									<tbody>
										{% for emplacement in emplacements %}
											<tr>
												<td>{{ loop.index }}</td>
												<td>{{ emplacement.id }}</td>
												<td>{{ emplacement.place ?? 'N/A' }}</td>
												<td>{{ emplacement.segment.filiere.nomFiliere }}->{{ emplacement.segment.nomSegment }}</td>
											</tr>
										{% endfor %}
									</tbody>
								</table>
							</div>
						{% else %}
							<p class="text-muted">Aucun emplacement sélectionné.</p>
						{% endif %}
					</div>
				</div>

				<!-- Formulaire de confirmation -->
				<div class="card">
					<div class="card-body">
						<h5 class="card-title">Confirmation</h5>
						<p class="card-text">
							Vérifiez attentivement les informations ci-dessus. Une fois confirmé, les cordes seront assignées aux emplacements et la date de mise à l'eau sera enregistrée.
						</p>

						<form method="post" active="{{ path('app_m_a_e_corde_validation') }}">
							<input type="hidden" name="confirm" value="1">

							<div class="d-grid gap-2 d-md-flex justify-content-md-end">
								<a href="{{ path('app_m_a_e_corde', {'parc': parc.id}) }}" class="btn btn-secondary me-md-2">
									<i class="fas fa-arrow-left"></i>
									Retour au formulaire
								</a>

								<button type="submit" class="btn btn-success">
									<i class="fas fa-check"></i>
									Confirmer et sauvegarder
								</button>

							</div>
						</form>
					</div>
				</div>
			</div>
		</div>
	</div>
{% endblock %}
