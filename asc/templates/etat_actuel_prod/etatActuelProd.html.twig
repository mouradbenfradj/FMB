{% extends 'base.html.twig' %}

{% block title %}EtatActuelProdController!
{% endblock %}
{% block stylesheets %}
	{{parent()}}
{% endblock %}
{% block myJS %}
	<script src="{{ asset('js/vendor.min.js') }}"></script>
	<!-- App js -->
	<!-- Footable js -->
	<script src="{{ asset('libs/footable/footable.all.min.js') }}"></script>

	<!-- Init js -->
	<script src="{{ asset('js/pages/foo-tables.init.js') }}"></script>
	<script src=".{{ asset('js/app.min.js') }}"></script>
{% endblock %}
{% block body %}
	<div class="row">
		<div class="col-sm-12">
			<div class="card-box">
				<h4 class="header-title">Etat Actuel Prod</h4>
				<p class="sub-header">
					<div class="mb-2">
						<div class="row">
							<div class="col-12 text-sm-center form-inline">
								<div class="form-group mr-2">
									<select id="demo-foo-filter-status" class="custom-select custom-select-sm">
										<option value="">Tri par Réf. Filière</option>
										<option value="active">Tri par Capacité Filière</option>
										<option value="active">Tri par Remplissage Filière</option>
										<option value="active">Tri par Flottabilité Filière</option>
									</select>
								</div>
								<div class="form-group mr-2">
									<select id="demo-foo-filter-status" class="custom-select custom-select-sm">
										<option value="">Croissant</option>
										<option value="active">Decroissant</option>
									</select>
								</div>
							</div>
						</div>
					</div>

					<div class="mb-2">
						<div class="row">
							<div class="col-12 text-sm-center form-inline">
								<button type="button" data-page-size="10">10</button>
								<button type="button" data-page-size="20">20</button>
								<button type="button" data-page-size="50">50</button>
								<button type="button" data-page-size="100">100</button>
								<button type="button" data-page-size="200">200</button>
							</div>
						</div>
					</div>
				</p>
				<table id="demo-foo-row-toggler" class="table table-bordered toggle-circle mb-0">
					<thead>
						<tr>


							<th data-toggle="true">Réf. Filière</th>
							<th>Remplissage Filière (%)</th>
							<th>Flottabilité Filière (%)</th>
							<th data-hide="all">Taille Filière (m)</th>
							<th data-hide="all">Total Emplacements (u)</th>
							<th data-hide="all">Emplacements Vides (u)</th>
							<th data-hide="all">Emplacements Remplis (u)</th>
							<th data-hide="all">Total Cordes (u)</th>
							<th data-hide="all">Total Cordes Huitre (u)</th>
							<th data-hide="all">Total Cordes Moule (u)</th>
							<th data-hide="all">Total Lanternes (u)</th>
							<th data-hide="all">Total Poches (u)</th>
							<th data-hide="all">Dérniere Date De MAE</th>
							<th data-hide="all">Total Passages chaussettes (u)</th>
							<th data-hide="all">Segments</th>
						</tr>
					</thead>
					<tbody>
						{% set pos = 0 %}
						{% for filiere in parc.filieres %}
							<tr>
								<td>{{filiere.nomFiliere}}</td>
								<td>
									{% set totaleCordes = filiere.totaleCordes is defined ? filiere.totaleCordes * 100 : 0 %}

									{% set remplissage = ( totaleCordes / (filiere.segments|map(segment => segment.emplacements|length)|reduce((l, v) => l + v) == 0 ?1 : filiere.segments|map(segment => segment.emplacements|length)|reduce((l, v) => l + v)))|round %}
									{% set rouge = remplissage %}

									<div class="progress mb-0">
										<div class="progress-bar bg-danger" role="danger" style="width: {{rouge}}%" aria-valuenow="{{rouge}}" aria-valuemin="0" aria-valuemax="100">
											{{rouge}}
											% R
										</div>
										<div class="progress-bar progress-bar-striped bg-success" role="progressbar" style="width: {{ 100 - rouge}}%" aria-valuenow=" {{ 100 - rouge}}%" aria-valuemin="0" aria-valuemax="100">
											{{ 100 - rouge}}
											% V
										</div>
									</div>
									<div class="row">
										<div class="col-lg-4">
											<div class="grid-container">
												Places totales
												{{ filiere.segments|map(segment => segment.emplacements|length)|reduce((l, v) => l + v) }}
											</div>
										</div>
										<div class="col-lg-4">
											<div class="grid-container">
												Places Remplies
												{{filiere.totaleCordes is defined ? filiere.totaleCordes : totaleCordes}}

											</div>
										</div>
										<div class="col-lg-4">
											<div class="grid-container">
												Places Vides
												{# {{filiere.segments|map(segment => segment.emplacements|length)|reduce((l, v) => l + v) - filiere.totaleCordes}}
																																																																								#}
											</div>
										</div>
									</div>
								</td>
							</tr>
						</td>
						<td>
							{#                                 {% include "etat_actuel_prod/partials/_flottabiliter.html.twig" with {remplissage: filiere.flottabiliter, poid: filiere.poidCordes} only %}
																																																																																																																																																																																																																																																																																 #}
							<div class="row">
								<div class="col-lg-3">
									<div class="grid-container">
										F
										{# 										{{filiere.volumesTotale}}
																																																																																																																																																																																																																																																																																																																																 #}
										(L)
									</div>
								</div>
								<div class="col-lg-3">
									<div class="grid-container">
										F
										{# 										{{filiere.flottabiliter}}
																																																																																																																																																																																																																																																																																																																																 #}
										(kgf)
									</div>
								</div>
								<div class="col-lg-6">
									<div class="grid-container">
										Production
										{# 										{{filiere.poidCordes}}
																																																																																																																																																																																																																																																																																																																																 #}
										(kgf)
									</div>
								</div>
							</div>


						</td>
						<td>{{ filiere.segments|map(segment => "#{segment.longeur}")|reduce((l, v) => l + v)  }}
							m</td>
						<td>
							{{  filiere.segments|map(segment => segment.emplacements|length)|reduce((l, v) => l + v) }}</td>
						<td>{# {{ filiere.segments|map(segment => segment.emplacements|length)|reduce((l, v) => l + v)Vide  }} #}</td>
						<td>{# {{ filiere.segments|map(segment => segment.emplacements|length)|reduce((l, v) => l + v)Remplit  }} #}</td>
						<td>{# {{filiere.totaleCordes}} #}</td>
						<td>0</td>
						<td>0</td>
						<td>0</td>
						<td>0</td>
						<td>0</td>
						<td>0</td>
						<td>
							{# 									{% include "segment/etatActuelProd.html.twig" with {pos: pos,filiere:filiere} only %}
																																																																																																																																																																																																																																																																																 #}
						</td>
					</tbody>
				</tr>
			{% endfor %}

		</tbody>
	</table>
</div>
<!-- end card-box --></div><!-- end col --></div><!-- end row -->{% endblock %}
